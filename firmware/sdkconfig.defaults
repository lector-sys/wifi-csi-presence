# CSI is only exposed when the WiFi driver is built with it enabled.
CONFIG_ESP_WIFI_CSI_ENABLED=y

# Power save off: with DTIM sleep the CSI stream arrives in bursts and the
# variance window sees gaps rather than movement.
CONFIG_ESP_WIFI_POWER_SAVE_MIN_MODEM=n

# The CSI callback runs on the WiFi task; give it room.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Serial fallback output is one JSON line per 500 ms, 115200 is plenty.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
